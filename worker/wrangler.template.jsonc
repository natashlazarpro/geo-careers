// Settings for the data-schield Worker. The GitHub workflow "Deploy data-schield" fills in
// the KV namespace id (__KV_ID__) and deploys it - don't edit the Worker in the Cloudflare dashboard.
{
  "name": "data-schield",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "kv_namespaces": [{ "binding": "DATA", "id": "__KV_ID__" }],
  // Emails each new employer suggestion. The recipient is the Worker secret NOTIFY_TO
  // (must be a verified Email Routing destination address); without it no email is sent.
  "send_email": [{ "name": "NOTIFY" }]
}
