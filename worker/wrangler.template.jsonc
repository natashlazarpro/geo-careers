// Settings for the data-schield Worker. The GitHub workflow "Deploy data-schield" fills in
// the KV namespace id (__KV_ID__) and deploys it - don't edit the Worker in the Cloudflare dashboard.
{
  "name": "data-schield",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "kv_namespaces": [{ "binding": "DATA", "id": "__KV_ID__" }]
}
