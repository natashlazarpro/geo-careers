// Cloudflare deploy settings for the GeoCareers website.
// Only the folder "public" is published (scripts/build_site.sh writes index.html into it),
// so the workbook and the rest of data/ stay private.
// The Mapbox token comes from the Cloudflare build secret MAPBOX_TOKEN.
{
  "name": "geo-careers",
  "compatibility_date": "2026-11-01",
  "build": { "command": "sh scripts/build_site.sh" },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  // Lets Cloudflare build a preview for non-main branches (wrangler preview needs this block; it can stay empty).
  "previews": {}
}
